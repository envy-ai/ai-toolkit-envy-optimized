{
  {% for prompt in prompts %}
  "{{ 1000 + loop.index0 }}": {
    "inputs": {"value": {{ prompt | json }}},
    "class_type": "easy string",
    "_meta": {"title": "Prompt {{ loop.index }}"}
  },
  {% endfor %}
  {% for seed_value in seeds %}
  "{{ 1100 + loop.index0 }}": {
    "inputs": {"value": {{ seed_value }}},
    "class_type": "easy int",
    "_meta": {"title": "Seed {{ loop.index }}"}
  },
  {% endfor %}
  {% for control_image in control_images %}
  "{{ 1400 + loop.index0 }}": {
    "inputs": {"image": {{ control_image | json }}},
    "class_type": "LoadImage",
    "_meta": {"title": "Load Primary Reference Image {{ loop.index }}"}
  },
  {% endfor %}
  {% for control_image in control_images_2 %}
  "{{ 1600 + loop.index0 }}": {
    "inputs": {"image": {{ control_image | json }}},
    "class_type": "LoadImage",
    "_meta": {"title": "Load Second Reference Image {{ loop.index }}"}
  },
  {% endfor %}
  {% for control_image in control_images_3 %}
  "{{ 1800 + loop.index0 }}": {
    "inputs": {"image": {{ control_image | json }}},
    "class_type": "LoadImage",
    "_meta": {"title": "Load Third Reference Image {{ loop.index }}"}
  },
  {% endfor %}
  {% for prompt in prompts %}
  {% if loop.index0 > 0 %}
  "{{ 1200 + loop.index0 - 1 }}": {
    "inputs": {
      "any_1": [{% if loop.index0 == 1 %}"1000"{% else %}"{{ 1200 + loop.index0 - 2 }}"{% endif %}, 0],
      "any_2": ["{{ 1000 + loop.index0 }}", 0]
    },
    "class_type": "easy batchAnything",
    "_meta": {"title": "Prompt List {{ loop.index }}"}
  },
  {% endif %}
  {% endfor %}
  {% for seed_value in seeds %}
  {% if loop.index0 > 0 %}
  "{{ 1300 + loop.index0 - 1 }}": {
    "inputs": {
      "any_1": [{% if loop.index0 == 1 %}"1100"{% else %}"{{ 1300 + loop.index0 - 2 }}"{% endif %}, 0],
      "any_2": ["{{ 1100 + loop.index0 }}", 0]
    },
    "class_type": "easy batchAnything",
    "_meta": {"title": "Seed List {{ loop.index }}"}
  },
  {% endif %}
  {% endfor %}
  {% for control_image in control_images %}
  {% if loop.index0 > 0 %}
  "{{ 1500 + loop.index0 - 1 }}": {
    "inputs": {
      "any_1": [{% if loop.index0 == 1 %}"1400"{% else %}"{{ 1500 + loop.index0 - 2 }}"{% endif %}, 0],
      "any_2": ["{{ 1400 + loop.index0 }}", 0]
    },
    "class_type": "easy batchAnything",
    "_meta": {"title": "Primary Reference Image List {{ loop.index }}"}
  },
  {% endif %}
  {% endfor %}
  {% for control_image in control_images_2 %}
  {% if loop.index0 > 0 %}
  "{{ 1700 + loop.index0 - 1 }}": {
    "inputs": {
      "any_1": [{% if loop.index0 == 1 %}"1600"{% else %}"{{ 1700 + loop.index0 - 2 }}"{% endif %}, 0],
      "any_2": ["{{ 1600 + loop.index0 }}", 0]
    },
    "class_type": "easy batchAnything",
    "_meta": {"title": "Second Reference Image List {{ loop.index }}"}
  },
  {% endif %}
  {% endfor %}
  {% for control_image in control_images_3 %}
  {% if loop.index0 > 0 %}
  "{{ 1900 + loop.index0 - 1 }}": {
    "inputs": {
      "any_1": [{% if loop.index0 == 1 %}"1800"{% else %}"{{ 1900 + loop.index0 - 2 }}"{% endif %}, 0],
      "any_2": ["{{ 1800 + loop.index0 }}", 0]
    },
    "class_type": "easy batchAnything",
    "_meta": {"title": "Third Reference Image List {{ loop.index }}"}
  },
  {% endif %}
  {% endfor %}
  "2": {
    "inputs": {"width": {{ width }}, "height": {{ height }}, "batch_size": 1},
    "class_type": "EmptyLatentImage",
    "_meta": {"title": "Empty Latent Image"}
  },
  "3": {
    "inputs": {
      "samples": ["17", 0],
      "vae": ["6", 0],
      "tile_size": 512,
      "overlap": 64,
      "temporal_size": 64,
      "temporal_overlap": 8
    },
    "class_type": "VAEDecodeTiled",
    "_meta": {"title": "VAE Decode (Tiled)"}
  },
  "4": {
    "inputs": {"unet_name": {{ model | json }}, "weight_dtype": "default"},
    "class_type": "UNETLoader",
    "_meta": {"title": "Load Qwen Image 2.1 Diffusion Model"}
  },
  "5": {
    "inputs": {
      "clip_name": {{ text_encoder | json }},
      "type": "qwen_image",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {"title": "Load Qwen Image 2.1 Text Encoder"}
  },
  "6": {
    "inputs": {"vae_name": {{ vae | json }}},
    "class_type": "VAELoader",
    "_meta": {"title": "Load Qwen Image 2.1 VAE"}
  },
  "17": {
    "inputs": {
      "seed": ["73", 0],
      "steps": {{ steps }},
      "cfg": {{ cfg }},
      "sampler_name": {{ sampler | json }},
      "scheduler": {{ scheduler | json }},
      "denoise": 1,
      "model": [{% if inference_lora_enabled %}"37"{% else %}"36"{% endif %}, 0],
      "positive": ["71", 0],
      "negative": ["71", 1],
      "latent_image": ["2", 0]
    },
    "class_type": "KSampler",
    "_meta": {"title": "KSampler"}
  },
  "23": {
    "inputs": {
      "filename_prefix": {{ filename_prefix | json }},
      "subdirectory_name": "",
      "output_format": {{ output_format | json }},
      "quality": {{ output_quality | json }},
      "metadata_scope": "full",
      "include_batch_num": true,
      "prefer_nearest": true,
      "images": ["50", 0]
    },
    "class_type": "SaveImageWithMetaData",
    "_meta": {"title": "Save Image With MetaData"}
  },
  "36": {
    "inputs": {
      "absolute_path": {{ training_lora_path | json }},
      "lora_strength": {{ training_lora_strength }},
      "model": ["4", 0],
      "clip": ["5", 0]
    },
    "class_type": "load_lora_from_absolute_path",
    "_meta": {"title": "Load Training LoRA From Absolute Path"}
  },
  {% if inference_lora_enabled %}
  "37": {
    "inputs": {
      {% if inference_lora_absolute_path %}
      "absolute_path": {{ inference_lora_absolute_path | json }},
      "lora_strength": {{ inference_lora_strength }},
      {% else %}
      "lora_name": {{ inference_lora | json }},
      "strength_model": {{ inference_lora_strength }},
      "strength_clip": {{ inference_lora_strength }},
      {% endif %}
      "model": ["36", 0],
      "clip": ["36", 1]
    },
    "class_type": {% if inference_lora_absolute_path %}"load_lora_from_absolute_path"{% else %}"LoraLoader"{% endif %},
    "_meta": {"title": "Load Inference LoRA"}
  },
  {% endif %}
  "41": {
    "inputs": {"total": {{ sample_count }}},
    "class_type": "easy forLoopStart",
    "_meta": {"title": "For Loop Start"}
  },
  "50": {
    "inputs": {"flow": ["41", 0], "initial_value1": ["74", 0]},
    "class_type": "easy forLoopEnd",
    "_meta": {"title": "For Loop End"}
  },
  "70": {
    "inputs": {
      "any": ["{{ 1200 + sample_count - 2 }}", 0],
      "index": ["41", 1]
    },
    "class_type": "easy indexAnything",
    "_meta": {"title": "Prompt by Loop Index"}
  },
  "71": {
    "inputs": {
      "clip": [{% if inference_lora_enabled %}"37"{% else %}"36"{% endif %}, 1],
      "prompt": ["70", 0],
      "negative_prompt": {{ negative_prompt | json }},
      "resolution": 1024{% if control_images | length > 0 %},
      "vae": ["6", 0],
      "images.image_1": ["80", 0]{% if control_images_2 | length > 0 %},
      "images.image_2": ["86", 0]{% endif %}{% if control_images_3 | length > 0 %},
      "images.image_3": ["88", 0]{% endif %}{% endif %}
    },
    "class_type": "TextEncodeQwenImage21",
    "_meta": {"title": "Text Encode Qwen Image 2.1"}
  },
  "73": {
    "inputs": {
      "any": ["{{ 1300 + sample_count - 2 }}", 0],
      "index": ["41", 1]
    },
    "class_type": "easy indexAnything",
    "_meta": {"title": "Seed by Loop Index"}
  },
  "74": {
    "inputs": {"any_1": ["41", 2], "any_2": ["3", 0]},
    "class_type": "easy batchAnything",
    "_meta": {"title": "Append Image to Batch"}
  }{% if control_images | length > 0 %},
  "80": {
    "inputs": {
      "any": ["{{ 1500 + sample_count - 2 }}", 0],
      "index": ["41", 1]
    },
    "class_type": "easy indexAnything",
    "_meta": {"title": "Primary Reference Image by Loop Index"}
  }{% if control_images_2 | length > 0 %},
  "86": {
    "inputs": {
      "any": ["{{ 1700 + sample_count - 2 }}", 0],
      "index": ["41", 1]
    },
    "class_type": "easy indexAnything",
    "_meta": {"title": "Second Reference Image by Loop Index"}
  }{% endif %}{% if control_images_3 | length > 0 %},
  "88": {
    "inputs": {
      "any": ["{{ 1900 + sample_count - 2 }}", 0],
      "index": ["41", 1]
    },
    "class_type": "easy indexAnything",
    "_meta": {"title": "Third Reference Image by Loop Index"}
  }{% endif %}{% endif %}
}
