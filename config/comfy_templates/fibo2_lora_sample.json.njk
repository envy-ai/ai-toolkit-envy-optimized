{
  "1": {"class_type": "UNETLoader", "inputs": {"unet_name": {{ model | json }}, "weight_dtype": "default"}},
  "2": {"class_type": "CLIPLoader", "inputs": {"clip_name": {{ text_encoder | json }}, "type": "fibo2", "device": "default"}},
  "3": {"class_type": "VAELoader", "inputs": {"vae_name": {{ vae | json }}}},
  "4": {"class_type": "load_lora_from_absolute_path", "inputs": {
    "absolute_path": {{ training_lora_path | json }}, "lora_strength": {{ training_lora_strength }}, "model": ["1", 0], "clip": ["2", 0]}},
  {% if inference_lora_enabled %}
  "5": {"class_type": {% if inference_lora_absolute_path %}"load_lora_from_absolute_path"{% else %}"LoraLoaderModelOnly"{% endif %}, "inputs": {
    {% if inference_lora_absolute_path %}
    "absolute_path": {{ inference_lora_absolute_path | json }}, "lora_strength": {{ inference_lora_strength }}, "clip": ["4", 1],
    {% else %}
    "lora_name": {{ inference_lora | json }}, "strength_model": {{ inference_lora_strength }},
    {% endif %}
    "model": ["4", 0]}},
  {% endif %}
  {% if control_image %}
  "20": {"class_type": "LoadImage", "inputs": {"image": {{ control_image | json }}}},
  {% endif %}
  {% if control_image_2 %}
  "21": {"class_type": "LoadImage", "inputs": {"image": {{ control_image_2 | json }}}},
  {% endif %}
  {% if control_image_3 %}
  "22": {"class_type": "LoadImage", "inputs": {"image": {{ control_image_3 | json }}}},
  {% endif %}
  "6": {"class_type": "TextEncodeFibo2", "inputs": {
    "clip": ["4", 1], "prompt": {{ prompt | json }}, "negative_prompt": {{ negative_prompt | json }},
    "vae": ["3", 0], "width": {{ width }}, "height": {{ height }}, "batch_size": 1
    {% if control_image %}, "images.image_1": ["20", 0]{% endif %}
    {% if control_image_2 %}, "images.image_2": ["21", 0]{% endif %}
    {% if control_image_3 %}, "images.image_3": ["22", 0]{% endif %}}},
  "7": {"class_type": "KSampler", "inputs": {
    "model": [{% if inference_lora_enabled %}"5"{% else %}"4"{% endif %}, 0],
    "positive": ["6", 0], "negative": ["6", 1], "latent_image": ["6", 2],
    "seed": {{ seed_literal }}, "steps": {{ steps }}, "cfg": {{ cfg }},
    "sampler_name": {{ sampler | json }}, "scheduler": {{ scheduler | json }}, "denoise": 1}},
  "8": {"class_type": {% if fibo2_standard_decode %}"VAEDecode"{% else %}"VAEDecodeTiled"{% endif %},
    "inputs": {"samples": ["7", 0], "vae": ["3", 0]
    {% if not fibo2_standard_decode %}, "tile_size": 512, "overlap": 64, "temporal_size": 64, "temporal_overlap": 8{% endif %}}},
  "9": {"class_type": "SaveImage", "inputs": {"images": ["8", 0], "filename_prefix": {{ filename_prefix | json }}}}
}
