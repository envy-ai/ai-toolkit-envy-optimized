{
  "29": {
    "class_type": "SaveImageWithMetaData",
    "inputs": {
      "filename_prefix": {{ filename_prefix | json }},
      "subdirectory_name": "",
      "output_format": {{ output_format | json }},
      "quality": {{ output_quality | json }},
      "metadata_scope": "full",
      "include_batch_num": true,
      "prefer_nearest": true,
      "images": ["54", 0]
    }
  },
  "53": {
    "class_type": "KSampler",
    "inputs": {
      "seed": {{ seed_literal }},
      "steps": {{ steps }},
      "cfg": {{ cfg }},
      "sampler_name": {{ sampler | json }},
      "scheduler": {{ scheduler | json }},
      "denoise": 1,
      "model": ["79", 0],
      "positive": ["84", 0],
      "negative": ["85", 0],
      "latent_image": ["82", 0]
    }
  },
  "54": {"class_type": "VAEDecode", "inputs": {"samples": ["53", 0], "vae": ["57", 0]}},
  "55": {"class_type": "UNETLoader", "inputs": {"unet_name": {{ model | json }}, "weight_dtype": "default"}},
  "56": {"class_type": "CLIPLoader", "inputs": {"clip_name": {{ text_encoder | json }}, "type": "krea2", "device": "default"}},
  "57": {"class_type": "VAELoader", "inputs": {"vae_name": {{ vae | json }}}},
  {% if inference_lora_enabled %}
  "71": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {"lora_name": {{ inference_lora | json }}, "strength_model": {{ inference_lora_strength }}, "model": ["55", 0]},
    "_meta": {"title": "Inference helper"}
  },
  {% endif %}
  "72": {"class_type": "LoadImage", "inputs": {"image": {{ control_image | json }}}},
  "73": {"class_type": "VAEEncode", "inputs": {"pixels": ["72", 0], "vae": ["57", 0]}},
  "79": {
    "class_type": "Krea2EditModelPatch",
    "inputs": {
      "ref_boost": 2,
      "ref_boost_a": 2,
      "fit_mode": {{ krea2_edit_fit_mode | json }},
      "model": ["111", 0],
      "source_latent": ["73", 0],
      "vae": ["57", 0],
      "source_image": ["72", 0],
      "target_latent": ["82", 0]
    }
  },
  "82": {"class_type": "EmptySD3LatentImage", "inputs": {"width": {{ width }}, "height": {{ height }}, "batch_size": 1}},
  "84": {
    "class_type": "Krea2EditGroundedEncode",
    "inputs": {"prompt": {{ prompt | json }}, "grounding_px": 0, "system_prompt": "", "clip": ["56", 0], "image": ["72", 0]},
    "_meta": {"title": "Positive grounded edit instruction"}
  },
  "85": {
    "class_type": "Krea2EditGroundedEncode",
    "inputs": {"prompt": {{ negative_prompt | json }}, "grounding_px": 768, "system_prompt": "", "clip": ["56", 0], "image": ["72", 0]},
    "_meta": {"title": "Negative grounded edit instruction"}
  },
  "111": {
    "class_type": "load_lora_from_absolute_path",
    "inputs": {
      "absolute_path": {{ training_lora_path | json }},
      "lora_strength": {{ training_lora_strength }},
      "model": [{% if inference_lora_enabled %}"71"{% else %}"55"{% endif %}, 0]
    },
    "_meta": {"title": "LoRA in training (model only)"}
  }
}
